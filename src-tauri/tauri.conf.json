{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Lezio",
  "version": "0.2.0",
  "identifier": "com.lezio.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Lezio",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/lezio-anhaenge/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyREQ3MTM3RjQ5NDdBMEUKUldRT2VwVDBOM0hkRW5JWVFORHU0Nkl0UU1CVGxxdDhlcEdPN2N5YmdvS2RkcmRiRzFYdTgrSHYK",
      "endpoints": [
        "https://github.com/tannheimerl/edtech-future-unicorn/releases/latest/download/latest.json"
      ]
    }
  }
}
